[sub_resource type="Resource" id="Resource_j3pel"]
script = ExtResource("7_drx8r")
text = "My husband was murdered by a group of filthy thieves just outside of the forest.

The thieves took everything from him, his boots, shirt, hat, hell they even took his small clothes!

Nothing he had was of any value, but he did have a cheap ring that he had inherited from his mother when she passed. It's a cheap metal ring hardly worth killing anyone over.

I would still very much like to have that ring back, just so that I could keep some memory of him near me.

You will probably find those rotten murdering thieves hiding underneath a stump or a bush in the forest! A bunch of cowards is all that they are."
metadata/_custom_type_script = "uid://bu2iii31o0rrx"

[sub_resource type="Resource" id="Resource_g28q7"]
script = ExtResource("7_drx8r")
text = "Yes that is it! You see, it isn't much, but it is enough."
metadata/_custom_type_script = "uid://bu2iii31o0rrx"

[sub_resource type="Resource" id="Resource_n8wo2"]
script = ExtResource("7_drx8r")
text = "Thank you strangers. Have a round on me!"
metadata/_custom_type_script = "uid://bu2iii31o0rrx"

