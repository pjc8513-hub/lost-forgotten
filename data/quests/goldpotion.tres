[resource]
script = ExtResource("5_fv68w")
quest_id = "linquest"
quest_name = "Fairy Potion"
description = "My mother used to tell me a story about a woman who drink a golden potion and was transformed into a fairy! Wouldn't that be wonderful? Do you think that potion really exists?"
stage_descriptions = {
0: "Not Started",
1: "There is an old story about a gold potion with the ability to change a person into a fairy.",
2: "Return the gold potion to Lin in Nobel.",
3: "Quest Completed"
}
