[resource]
script = ExtResource("3_i1wif")
quest_id = "BonePit"
quest_name = "Bone Pit"
is_main_quest = true
description = "There are rumors of necromancy being performed in the Bone Pit!

The Bone Pit is a very old fortress in the swamp to the south. It hasn't been used as a fortress since the Olden Days, instead it has been used as a place of honorable burial for warriors born in the Swamp. The thought of someone using that foul and twisted black art on the bones of their ancestors has raised ire among the swamp-folk.

Would you go and see if the rumors are true."
display_name = "Swamp"
destination_map = "uid://cvlmtn24nm6e"
quest_rewards = SubResource("Resource_tfufr")
metadata/_custom_type_script = "uid://phuimf2skp05"
